import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('Chocolate_Sales.csv')

print("Dataset Shape:", df.shape)
print("\nFirst 5 rows:")
print(df.head())

print("\nColumn names and data types:")
print(df.dtypes)

df['Amount'] = df['Amount'].replace('[\$,]', '', regex=True).astype(float)

print("\nBasic Statistics:")
print(df.describe())

print("\nMissing Values:")
print(df.isnull().sum())

df['Date'] = pd.to_datetime(df['Date'], format='%d/%m/%Y')

df['Month'] = df['Date'].dt.to_period('M')
monthly_revenue = df.groupby('Month')['Amount'].sum()

plt.figure(figsize=(12,6))
monthly_revenue.plot(kind='line', marker='o', color='purple')
plt.title("Monthly Revenue Trend (Chocolate Sales)")
plt.ylabel("Total Revenue ($)")
plt.xlabel("Month")
plt.grid(True)
plt.show()


country_sales = df.groupby('Country')['Amount'].sum().sort_values(ascending=False)

plt.figure(figsize=(10,5))
country_sales.plot(kind='bar', color='skyblue')
plt.title("Total Sales by Country")
plt.ylabel("Total Revenue ($)")
plt.show()


product_sales = df.groupby('Product')['Amount'].sum().sort_values(ascending=False).head(10)

plt.figure(figsize=(10,5))
product_sales.plot(kind='barh', color='green')
plt.title("Top 10 Products by Revenue")
plt.xlabel("Total Revenue ($)")
plt.show()


plt.figure(figsize=(8,6))
sns.scatterplot(x='Boxes Shipped', y='Amount', data=df, alpha=0.6)
plt.title("Relationship between Boxes Shipped and Revenue")
plt.show()


print("\n=== Key Insights ===")
print("- Highest selling country:", country_sales.index[0])
print("- Top product:", product_sales.index[0])
print("- Total revenue:", df['Amount'].sum())
print("- Average boxes shipped per transaction:", df['Boxes Shipped'].mean().round(2))
